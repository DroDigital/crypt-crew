// Windows resources: icon + version info.
#include <winver.h>
IDI_ICON1 ICON "@CC_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @CC_VER_COMMA@,0
PRODUCTVERSION @CC_VER_COMMA@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Crypt Crew"
      VALUE "FileDescription", "Crypt Crew"
      VALUE "FileVersion", "@CC_VERSION@"
      VALUE "ProductName", "Crypt Crew"
      VALUE "ProductVersion", "@CC_VERSION@"
      VALUE "OriginalFilename", "CryptCrew.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
